---
import '../styles/global.css';

interface Props {
  locale: 'it' | 'en';
  title: string;
}

const { locale, title } = Astro.props;
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { initCustomCursor } from '../scripts/custom-cursor';
      initCustomCursor();
    </script>
  </body>
</html>
